# Copy this file to .env and fill in your Alpaca PAPER keys (dashboard → Paper Trading → API Keys).
# .env is in .gitignore, so it never gets uploaded. Never paste keys into code or chat.

# Paper 1: the day trader (also used to download price data)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper 2: ML moderate
MODERATE_API_KEY=
MODERATE_SECRET_KEY=

# Paper 3: ML safe
SAFE_API_KEY=
SAFE_SECRET_KEY=
